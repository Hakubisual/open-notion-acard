{
  "name": "acard-local-desktop",
  "productName": "Acard Local",
  "version": "0.3.3",
  "private": true,
  "description": "Acard Local: Notion-style notes on your own computer, or a client for your team's Acard server",
  "author": "Acard contributors",
  "license": "AGPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "stage": "bun stage.ts",
    "dist": "bun stage.ts && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "dev.acard.local",
    "productName": "Acard Local",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "connect.html",
      "icon.png",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "stage/app",
        "to": "app"
      },
      {
        "from": "stage/server",
        "to": "server"
      }
    ],
    "artifactName": "Acard-Local-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Acard-Local-Setup-${version}.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Acard Local"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "icon.png"
    }
  }
}
